{
  "expo": {
    "name": "Speakia",
    "slug": "speakia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speakia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4C7DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.speakia.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "speakia",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Speakia uses the microphone so you can speak in the story."
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF5"
        }
      ]
    ]
  }
}
